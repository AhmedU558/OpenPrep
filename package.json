{
  "name": "openprep",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source exam practice platform: question bank, timed exams, explanations, flashcards, analytics and study planner.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db mail",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "bank:batch": "tsx scripts/question-bank.ts",
    "bank:preserve": "tsx scripts/bank-baseline.ts --verify",
    "bank:verify": "tsx scripts/verify-bank.ts",
    "bank:expand": "tsx scripts/expansion-batch.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:int": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "legacy": "node legacy/server.js",
    "release:check-content": "node scripts/check-content-distribution.mjs",
    "compliance:provenance": "node scripts/verify-publisher-provenance.mjs",
    "compliance:sbom": "python scripts/release-compliance.py sbom",
    "compliance:check": "python scripts/release-compliance.py check",
    "compliance:test": "python -m unittest discover -s tests/compliance -v",
    "compliance:validate": "python scripts/validate-sbom.py",
    "release:preflight": "python scripts/release-compliance.py check"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "isomorphic-dompurify": "4.5.0",
    "marked": "18.1.1",
    "next": "16.4.1",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
