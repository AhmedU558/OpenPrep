# Copy to .env and adjust. Never commit .env.

# Product name shown in the UI
NEXT_PUBLIC_APP_NAME=OpenPrep

# Public URL of the app (used for links in emails and auth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# PostgreSQL (docker compose defaults)
DATABASE_URL=postgresql://openprep:openprep_dev_only@localhost:5432/openprep?schema=public
TEST_DATABASE_URL=postgresql://openprep:openprep_dev_only@localhost:5432/openprep_test?schema=public

# Outgoing email. Mailpit (docker compose) catches mail locally at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OpenPrep <no-reply@localhost>"

# Optional: `npm run db:seed` creates or promotes this account to ADMIN. Leave empty to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional AI study assistant. Leave empty to disable (the app works fully without it).
#   AI_PROVIDER=ollama             AI_BASE_URL=http://localhost:11434   AI_MODEL=llama3.1
#   AI_PROVIDER=openai-compatible  AI_BASE_URL=https://...              AI_MODEL=...   AI_API_KEY=...
# Hosted providers usually charge per request; Ollama runs locally on your own hardware.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
